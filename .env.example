# Project SHADE Environment Configuration Template
# Copy this file to .env and insert your personal API keys

# NVIDIA NIM API (For Nemotron-120B, Laguna XS 2.1, Nemotron 3.5 Lightning, GPT-OSS 120B)
NVIDIA_API_KEY=nvapi-your-key-here

# Groq Cloud API (Multi-Key round-robin rotation for Groq Compound)
GROQ_API_KEY=gsk_your_primary_key_here
GROQ_API_KEY_2=gsk_your_secondary_key_here
GROQ_API_KEY_3=gsk_your_tertiary_key_here

# Mistral AI Native SDK (For Mistral Medium)
MISTRAL_API_KEY=your_mistral_api_key_here

# TokenRouter API (For GLM 5.3 Free)
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here

# Optional Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
