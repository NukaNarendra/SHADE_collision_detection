\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/01/01 NeurIPS 2026 Submission/Camera-ready style file]

\DeclareOption{final}{\@finaltrue}
\DeclareOption{preprint}{\@preprinttrue}
\DeclareOption{nonatbib}{\@nonatbibtrue}
\newif\if@final\@finalfalse
\newif\if@preprint\@preprintfalse
\newif\if@nonatbib\@nonatbibfalse

\ProcessOptions\relax

\if@final
  \typeout{NeurIPS 2026 Camera-ready Version}
\else
  \if@preprint
    \typeout{NeurIPS 2026 Preprint Version}
  \else
    \typeout{NeurIPS 2026 Submission Version}
  \fi
\fi

\usepackage{geometry}
\geometry{
  letterpaper,
  textwidth=5.5in,
  textheight=9in,
  marginparsep=11pt,
  marginparwidth=1.07in,
  top=1in,
  headheight=12pt,
  headsep=0.33in,
  footskip=0.33in,
}

\if@nonatbib
\else
  \usepackage[numbers]{natbib}
\fi

\def\@maketitle{%
  \vbox{%
    \hsize\textwidth
    \linewidth\hsize
    \vskip 0.1in
    \begin{center}%
      {\LARGE \bf \@title \par}%
      \vskip 0.25in%
      \if@final
        \def\And{%
          \end{tabular}\hfil\penalty 10000\hfil%
          \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}%
        \def\and{%
          \end{tabular}\hfil\penalty -10000\hfil%
          \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}%
        \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\@author\end{tabular}%
      \else
        \if@preprint
          \def\And{%
            \end{tabular}\hfil\penalty 10000\hfil%
            \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}%
          \def\and{%
            \end{tabular}\hfil\penalty -10000\hfil%
            \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\ignorespaces}%
          \begin{tabular}[t]{c}\bf\rule{\z@}{24pt}\@author\end{tabular}%
        \else
          Anonymous Author(s)\\
          Affiliation\\
          Address\\
          \texttt{email}
        \fi
      \fi
    \end{center}%
    \vskip 0.3in \@minus 0.1in
  }%
}

\renewcommand{\section}{\@startsection{section}{1}{\z@}%
  {-2.0ex \@plus -0.5ex \@minus -0.2ex}%
  {1.5ex \@plus 0.2ex}%
  {\large\bf\raggedright}}

\renewcommand{\subsection}{\@startsection{subsection}{2}{\z@}%
  {-1.8ex \@plus -0.5ex \@minus -0.2ex}%
  {0.8ex \@plus 0.2ex}%
  {\normalsize\bf\raggedright}}

\renewcommand{\subsubsection}{\@startsection{subsubsection}{3}{\z@}%
  {-1.5ex \@plus -0.5ex \@minus -0.2ex}%
  {0.5ex \@plus 0.2ex}%
  {\normalsize\bf\raggedright}}

\renewcommand{\paragraph}{\@startsection{paragraph}{4}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}%
  {-1em}%
  {\normalsize\bf}}

\renewcommand{\subparagraph}{\@startsection{subparagraph}{5}{\z@}%
  {1.5ex \@plus 0.5ex \@minus 0.2ex}%
  {-1em}%
  {\normalsize\bf}}

\clubpenalty=10000
\widowpenalty=10000

\endinput
